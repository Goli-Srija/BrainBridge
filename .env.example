# ===================== BrainBridge environment variables =====================
# Copy this file to ".env" (same folder) and fill in the values. Never commit .env.

# 1) Neon PostgreSQL connection string
#    Neon dashboard -> your project -> Connect -> copy the "connection string" (it ends with ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2) Secret used to sign login tokens (any long random text, 32+ characters)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# 3) Backend port and allowed frontend origin(s) (comma separated)
PORT=5000
CLIENT_URL=http://localhost:5173

# 4) Code execution for the coding module (choose ONE)
#    local  = run code with Python / Java (JDK) / gcc installed on this computer (default in development)
#    judge0 = use a Judge0 server (set JUDGE0_URL; for RapidAPI also set JUDGE0_API_KEY)
#    none   = editor + saving only, no execution
CODE_RUNNER=local
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your-rapidapi-key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
CODE_TIMEOUT_MS=5000

# 5) OPTIONAL AI feedback for interviews/communication (leave empty for rule-based only)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# ----- Frontend (only needed when the frontend is deployed separately) -----
# VITE_API_URL=https://your-backend.onrender.com/api
